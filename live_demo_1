import os

# Must be set BEFORE importing cv2: avoids a common Windows camera failure
os.environ["OPENCV_VIDEOIO_MSMF_ENABLE_HW_TRANSFORMS"] = "0"

import sys
import time
import textwrap
import subprocess
import cv2
import numpy as np
import mediapipe as mp
from collections import deque, Counter
from common import normalize_landmarks, KNNClassifier

SAMPLES_PER_SIGN = 200
COUNTDOWN_SECONDS = 3
HOLD_SECONDS = 1.0        # how long to hold a sign to add it to the sentence
FLIP = True               # must match FLIP in collect_custom.py
START_FULLSCREEN = False  # set True to open in fullscreen
WINDOW_SCALE = 1.5        # size of the normal window relative to the camera

CUSTOM_FILE = "custom_features.npz"
BASE_FILES = ["features.npz", "extra_features.npz"]
MODEL_FILE = "sign_model.npz"
WINDOW = "Sign Language Recognition"


# ---------- camera ----------
def open_camera():
    """Try several backends and camera indexes until one delivers frames."""
    backends = [
        ("DirectShow", cv2.CAP_DSHOW),
        ("Media Foundation", cv2.CAP_MSMF),
        ("default", cv2.CAP_ANY),
    ]
    for index in (0, 1, 2):
        for name, backend in backends:
            cap = cv2.VideoCapture(index, backend)
            if cap.isOpened():
                for _ in range(15):          # cameras need a moment to warm up
                    ok, frame = cap.read()
                    if ok and frame is not None:
                        print(f"Camera ready: index {index}, backend {name}")
                        return cap
                    time.sleep(0.1)
            cap.release()
    return None


# ---------- fullscreen ----------
fullscreen = False


def set_fullscreen(on):
    global fullscreen
    fullscreen = on
    cv2.setWindowProperty(
        WINDOW, cv2.WND_PROP_FULLSCREEN,
        cv2.WINDOW_FULLSCREEN if on else cv2.WINDOW_NORMAL,
    )


# ---------- data helpers ----------
def load_npz(fname):
    if not os.path.exists(fname):
        return None
    d = np.load(fname)
    if len(d["X"]) == 0:
        return None
    return d["X"], d["y"]


def build_model():
    """Combine all feature files, fit the model, and save it."""
    Xs, ys = [], []
    for f in BASE_FILES + [CUSTOM_FILE]:
        data = load_npz(f)
        if data is not None:
            Xs.append(data[0])
            ys.append(data[1])
    if not Xs:
        return None
    X = np.concatenate(Xs)
    y = np.concatenate(ys)
    model = KNNClassifier(k=5).fit(X, y)
    model.save(MODEL_FILE)
    return model


def save_custom_samples(label, samples):
    new_X = np.array(samples, dtype=np.float32)
    new_y = np.array([label] * len(samples))
    old = load_npz(CUSTOM_FILE)
    if old is not None:
        new_X = np.concatenate([old[0], new_X])
        new_y = np.concatenate([old[1], new_y])
    np.savez(CUSTOM_FILE, X=new_X, y=new_y)


def delete_custom_label(label):
    """Remove one custom sign. Returns True if something was removed."""
    old = load_npz(CUSTOM_FILE)
    if old is None:
        return False
    X, y = old
    keep = y != label
    if keep.all():
        return False
    if keep.any():
        np.savez(CUSTOM_FILE, X=X[keep], y=y[keep])
    else:
        os.remove(CUSTOM_FILE)
    return True


def custom_labels():
    data = load_npz(CUSTOM_FILE)
    return sorted(set(data[1])) if data is not None else []


# ---------- sentence helpers ----------
def add_token(sentence, label):
    """Add a recognized sign to the sentence."""
    low = label.lower()
    if low == "space":
        if sentence and not sentence.endswith(" "):
            sentence += " "
        return sentence
    if low == "del":
        return sentence[:-1]
    if len(label) == 1:                      # a letter
        return sentence + label
    word = label.replace("_", " ")           # a whole-word sign
    if sentence and not sentence.endswith(" "):
        sentence += " "
    return sentence + word + " "


# ---------- drawing helpers ----------
def put(frame, text, y, color=(0, 255, 0), scale=0.8, thick=2):
    cv2.putText(frame, text, (20, y), cv2.FONT_HERSHEY_SIMPLEX,
                scale, (0, 0, 0), thick + 3)
    cv2.putText(frame, text, (20, y), cv2.FONT_HERSHEY_SIMPLEX,
                scale, color, thick)


def draw_sentence_panel(frame, sentence):
    h, w = frame.shape[:2]
    panel_h = 120
    overlay = frame.copy()
    cv2.rectangle(overlay, (0, h - panel_h), (w, h), (0, 0, 0), -1)
    cv2.addWeighted(overlay, 0.65, frame, 0.35, 0, frame)

    lines = textwrap.wrap(sentence, 32) or [""]
    lines = lines[-3:]
    lines[-1] += "_"                         # cursor
    y = h - panel_h + 38
    for line in lines:
        cv2.putText(frame, line, (20, y), cv2.FONT_HERSHEY_SIMPLEX,
                    1.0, (255, 255, 255), 2)
        y += 36


# ---------- setup ----------
cap = open_camera()
if cap is None:
    print("\nCould not get frames from any camera.")
    print("- Close Zoom, Teams, the Camera app and browser tabs using the camera")
    print("- Windows Settings > Privacy & security > Camera: allow desktop apps")
    print("- If it still fails, restart the computer and try again")
    sys.exit(1)

model = build_model()

mp_hands = mp.solutions.hands
mp_draw = mp.solutions.drawing_utils
hands = mp_hands.Hands(
    static_image_mode=False,
    max_num_hands=1,
    min_detection_confidence=0.6,
    min_tracking_confidence=0.6,
)

# KEEPRATIO stops the picture from stretching when the window is resized
cv2.namedWindow(WINDOW, cv2.WINDOW_NORMAL | cv2.WINDOW_KEEPRATIO)

history = deque(maxlen=10)

state = "live"        # live, typing, countdown, capture
action = None         # "add" or "delete" (used while typing)
typed = ""
label = ""
countdown_end = 0.0
samples = []
message = ""
message_until = 0.0

sentence = ""
candidate = None      # sign currently being held
candidate_since = 0.0
locked = False        # True once the held sign has been added
progress = 0.0
failed_reads = 0
first_frame = True


def flash(text, seconds=3):
    global message, message_until
    message = text
    message_until = time.time() + seconds


def speak(text):
    """Read the sentence aloud using Windows' built-in voice."""
    text = "".join(ch for ch in text if ch.isalnum() or ch == " ").strip()
    if not text:
        flash("Nothing to say yet")
        return
    cmd = [
        "powershell", "-NoProfile", "-Command",
        "Add-Type -AssemblyName System.Speech; "
        "(New-Object System.Speech.Synthesis.SpeechSynthesizer)"
        ".Speak('" + text + "')",
    ]
    try:
        flags = getattr(subprocess, "CREATE_NO_WINDOW", 0)
        subprocess.Popen(cmd, creationflags=flags)
        flash("Speaking...")
    except Exception:
        flash("Speech is not available on this computer")


while True:
    ok, frame = cap.read()
    if not ok or frame is None:
        failed_reads += 1
        if failed_reads > 30:
            print("Lost the camera feed. Close other apps using the camera and retry.")
            break
        time.sleep(0.03)
        continue
    failed_reads = 0

    if FLIP:
        frame = cv2.flip(frame, 1)

    if first_frame:
        fh, fw = frame.shape[:2]
        cv2.resizeWindow(WINDOW, int(fw * WINDOW_SCALE), int(fh * WINDOW_SCALE))
        if START_FULLSCREEN:
            set_fullscreen(True)
        first_frame = False

    rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    result = hands.process(rgb)

    hand = None
    if result.multi_hand_landmarks:
        hand = result.multi_hand_landmarks[0]
        mp_draw.draw_landmarks(frame, hand, mp_hands.HAND_CONNECTIONS)

    # ---------- per-state logic and drawing ----------
    if state == "live":
        if hand is not None and model is not None:
            features = normalize_landmarks(hand).reshape(1, -1)
            history.append(model.predict(features)[0])
            text = Counter(history).most_common(1)[0][0]

            now = time.time()
            if text != candidate:
                candidate = text
                candidate_since = now
                locked = False
            held = now - candidate_since
            if not locked and held >= HOLD_SECONDS:
                sentence = add_token(sentence, text)
                locked = True
            progress = 1.0 if locked else min(held / HOLD_SECONDS, 1.0)
        else:
            history.clear()
            candidate = None
            locked = False
            progress = 0.0
            text = "Press N to add a sign" if model is None else "No hand"

        cv2.putText(frame, text, (30, 90), cv2.FONT_HERSHEY_SIMPLEX,
                    2, (0, 255, 0), 4)

        # hold progress bar
        cv2.rectangle(frame, (30, 110), (330, 126), (60, 60, 60), -1)
        bar_color = (0, 200, 0) if locked else (0, 165, 255)
        cv2.rectangle(frame, (30, 110), (30 + int(300 * progress), 126),
                      bar_color, -1)

        draw_sentence_panel(frame, sentence)
        put(frame, "Space: gap  Bksp: erase  C: clear  S: speak",
            frame.shape[0] - 145, (255, 255, 255), 0.55, 1)
        put(frame, "N: add  D: delete  Tab: fullscreen  Q: quit",
            frame.shape[0] - 125, (255, 255, 255), 0.55, 1)

    elif state == "typing":
        verb = "NEW sign name" if action == "add" else "custom sign to DELETE"
        put(frame, f"Type {verb}:", 40, (0, 200, 255))
        put(frame, typed + "_", 85, (255, 255, 255), 1.0)
        put(frame, "Enter = confirm   Esc = cancel   Backspace = erase",
            frame.shape[0] - 20, (255, 255, 255), 0.6, 1)
        existing = custom_labels()
        if existing:
            put(frame, "Custom signs: " + ", ".join(existing),
                frame.shape[0] - 55, (200, 200, 200), 0.6, 1)

    elif state == "countdown":
        remaining = countdown_end - time.time()
        if remaining <= 0:
            samples = []
            history.clear()
            state = "capture"
        else:
            put(frame, f"Get ready to show: {label}", 40, (0, 200, 255))
            cv2.putText(frame, str(int(remaining) + 1), (30, 150),
                        cv2.FONT_HERSHEY_SIMPLEX, 3, (0, 200, 255), 6)

    elif state == "capture":
        if hand is not None:
            samples.append(normalize_landmarks(hand))
        put(frame, f"RECORDING {label}: {len(samples)}/{SAMPLES_PER_SIGN}",
            40, (0, 0, 255))
        put(frame, "Move your hand slightly closer/farther and tilt a bit",
            80, (255, 255, 255), 0.6, 1)
        if len(samples) >= SAMPLES_PER_SIGN:
            save_custom_samples(label, samples)
            model = build_model()
            history.clear()
            candidate = None
            locked = False
            flash(f"Learned '{label}'!")
            state = "live"

    if time.time() < message_until:
        put(frame, message, 165 if state == "live" else frame.shape[0] - 90,
            (0, 255, 255))

    cv2.imshow(WINDOW, frame)

    # ---------- keyboard ----------
    key = cv2.waitKey(1) & 0xFF
    if key == 255:
        continue

    # Tab toggles fullscreen in every state
    if key == 9:
        set_fullscreen(not fullscreen)
        continue

    # Esc leaves fullscreen first (only while in normal live mode)
    if key == 27 and fullscreen and state == "live":
        set_fullscreen(False)
        continue

    if state == "live":
        if key in (ord("q"), ord("Q")):
            break
        elif key in (ord("f"), ord("F")):
            set_fullscreen(not fullscreen)
        elif key in (ord("n"), ord("N")):
            state, action, typed = "typing", "add", ""
        elif key in (ord("d"), ord("D")):
            if custom_labels():
                state, action, typed = "typing", "delete", ""
            else:
                flash("No custom signs to delete")
        elif key in (ord("c"), ord("C")):
            sentence = ""
        elif key in (ord("s"), ord("S")):
            speak(sentence)
        elif key == 32:                     # Space bar
            sentence = add_token(sentence, "space")
        elif key in (8, 127):               # Backspace
            sentence = sentence[:-1]

    elif state == "typing":
        if key == 27:                       # Esc
            state = "live"
        elif key in (13, 10):               # Enter
            if not typed:
                state = "live"
            elif action == "add":
                label = typed
                countdown_end = time.time() + COUNTDOWN_SECONDS
                state = "countdown"
            else:
                if delete_custom_label(typed):
                    model = build_model()
                    flash(f"Deleted '{typed}'")
                else:
                    flash(f"'{typed}' not found in custom signs")
                state = "live"
        elif key in (8, 127):               # Backspace
            typed = typed[:-1]
        elif 32 <= key < 127 and len(typed) < 20:
            ch = chr(key).upper()
            if ch == " ":
                ch = "_"
            if ch.isalnum() or ch in "_-":
                typed += ch

    elif state in ("countdown", "capture"):
        if key == 27:                       # Esc cancels
            samples = []
            flash("Cancelled")
            state = "live"

cap.release()
cv2.destroyAllWindows()